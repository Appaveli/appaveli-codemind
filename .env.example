# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4000

#Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL="claude-sonnet-4-5-20250929"  
ANTHROPIC_MAX_TOKENS="4000"
# Application Configuration
LOG_LEVEL=INFO
CACHE_DIR=.appaveli_cache

# Web API Authentication
# Generate a secure random key for production:
# python -c "import secrets; print(f'cm_admin_{secrets.token_urlsafe(32)}')"
CODEMIND_ADMIN_KEY=your_admin_key_here

# CORS Configuration
# Comma-separated list of allowed origins (no spaces)
# Development default: http://localhost:3000,http://localhost:8000
# Production example: https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Development
DEBUG=false